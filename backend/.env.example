# Backend
PORT=5000
NODE_ENV=development

# Firebase Admin SDK / Firestore
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Or use GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Comma-separated frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4173,http://127.0.0.1:4173
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
