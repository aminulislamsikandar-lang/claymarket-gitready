{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "server": "node backend/src/server.js",
    "seed": "node backend/src/seed/seed.js",
    "dev:server": "node --watch backend/src/server.js",
    "dev:full": "concurrently -k \"npm run server\" \"npm run dev\"",
    "backend:start": "node backend/src/server.js",
    "backend:dev": "node --watch backend/src/server.js",
    "backend:seed": "node backend/src/seed/seed.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "firebase": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "concurrently": "^9.2.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
