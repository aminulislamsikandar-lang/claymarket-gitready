# Frontend / Vite
VITE_SITE_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
VITE_GA_ID=

# Firebase Web App configuration (Firebase Console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional Firebase Analytics measurement ID
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary (used for all image uploads instead of Firebase Storage, so the
# app does not require the paid Firebase Blaze plan).
# Sign up free at https://cloudinary.com (no card required), then:
#   1. Copy your "Cloud name" from the Cloudinary Dashboard.
#   2. Go to Settings -> Upload -> Upload presets -> "Add upload preset",
#      set Signing Mode to "Unsigned", and save. Copy its preset name below.
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
